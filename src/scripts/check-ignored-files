#!/bin/sh
# Fails if any tracked file is matched by .gitignore rules.
# Equivalent of funfair-server-template check-no-ignored-files action.

die() {
    printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    exit 1
}

# The file list is read, filtered and checked NUL-separated end to end (git
# -z, grep -z), so a tracked name holding a non-ASCII byte, a double quote, a
# backslash or a control character is reported by its real name rather than
# the C-quoted form line-separated git output gives it ("f\303\263o.log",
# quotes included). check-ignore's NUL-separated output goes to a temp file,
# not straight into tr, so that its own exit status is the one tested below.
# A name containing a newline is reported as two lines; such names are not
# supported.
IGNORED_FILE=$(mktemp "${TMPDIR:-/tmp}/check-ignored-files.XXXXXXXXXX") || die "mktemp failed"
trap 'rm -f "$IGNORED_FILE"' EXIT

git ls-files -z | grep -zv 'server\.pfx' | grep -zv '\.gitignore' \
    | git check-ignore --stdin -z --no-index > "$IGNORED_FILE" 2>/dev/null
STATUS=$?
IGNORED=$(tr '\000' '\n' < "$IGNORED_FILE")

# git check-ignore exits 1 when no files matched (including when it was given
# none to check); that's a pass
if [ $STATUS -eq 1 ] || [ -z "$IGNORED" ]; then
    exit 0
fi

if [ $STATUS -ne 0 ]; then
    die "git check-ignore failed"
fi

printf '\n\033[31m✗\033[0m %s\n' "Ignored files found in tracking:" >&2
printf '%s\n' "$IGNORED" | sed 's/^/  /' | sort -u >&2
exit 1
