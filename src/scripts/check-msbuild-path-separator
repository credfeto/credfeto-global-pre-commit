#!/bin/sh
# Flags a literal backslash used as a path separator in MSBuild project
# files (*.props/*.targets/*.csproj/*.slnx). Backslash is a legal
# filename character on Linux, not a separator, so a hand-typed backslash
# path (e.g. "$(MSBuildThisFileDirectory)..\LICENSE" or
# "$(SolutionDir)\..\results\...") silently never resolves on Linux
# self-hosted runners even though it looks correct on Windows. Forward
# slash is the cross-platform-correct separator for MSBuild/.NET tooling
# on every OS.
#
# .sln is deliberately out of scope: it is not XML, and both Visual Studio
# and `dotnet sln add` write backslash-separated relative project paths
# into it as a matter of convention on every OS, including Linux (verified
# directly). That backslash is correct there, not a bug. .slnx, the newer
# XML solution format, uses forward slashes and remains covered.
#
# A single-line XML comment span is stripped from each line before
# matching, rather than excluding the whole line, so a real violation
# sharing a line with a trailing comment is still caught. The legitimate
# NuGet PackagePath="\" root-marker convention needs no exclusion of its
# own: a bare backslash between quotes never matches the detection regex
# below in the first place, and a whole-line exclusion for it would
# silently swallow a real violation sharing the line with a
# PackagePath="\" attribute.
CANDIDATES=$(awk '
    {
        line = $0
        gsub(/<!--.*-->/, "", line)
        if (line ~ /\.\.\\|\\\.\\|\)\\/) print FILENAME ":" FNR
    }
' "$@")

if [ -n "$CANDIDATES" ]; then
    printf '\n\033[31m✗\033[0m %s\n' "Backslash used as a path separator in MSBuild file(s):" >&2
    printf '%s\n' "$CANDIDATES" | while IFS=: read -r FILE LINE_NO _; do
        printf '  %s:%s: literal backslash used as a path separator — use / instead\n' "$FILE" "$LINE_NO" >&2
    done
    exit 1
fi

exit 0
