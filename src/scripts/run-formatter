#!/bin/sh
# Applies dotnet format to staged .cs files, then cscleanup (Credfeto.DotNet.Repo.Formatter)
# to staged .cs and .csproj files, re-staging any files modified by either step.
#
# Usage: run-formatter [--all-files]
#
# --all-files mode (invoked by hooks/pre-commit's own --all-files mode) has
# no commit in progress: it targets every tracked .cs/.csproj file (git
# ls-files) instead of only staged ones, still re-staging anything it
# modifies -- the whole point of --all-files is a detect-and-fix baseline
# pass, not just a report.

TOOL_CMD="cscleanup"
TOOL_PKG="Credfeto.DotNet.Repo.Formatter"

die() {
    printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    exit 1
}

success() {
    printf '\n\033[32m✓\033[0m %s\n' "$*"
}

info() {
    printf '\n\033[32m→\033[0m %s\n' "$*"
}

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=src/scripts/lib/mode-arg.sh
. "$SCRIPT_DIR/lib/mode-arg.sh"
parse_all_files_mode_arg "$1"

# Returns true (0) when running inside a Claude Code Bash-tool session.
# Claude Code sets CLAUDECODE=1 in every shell it spawns via the Bash tool;
# that value is inherited by subprocesses (e.g. git hooks).
# Source: https://docs.anthropic.com/en/docs/claude-code/settings#environment-variables
is_ai_agent() {
    [ "${CLAUDECODE}" = "1" ]
}

# Returns 0 if $1 (command name) and $2 (package ID) match the same row in local or global dotnet tool list.
dotnet_tool_installed() {
    dotnet tool list 2>/dev/null \
        | awk -v cmd="$1" -v pkg="$2" \
            'tolower($3)==tolower(cmd) && tolower($1)==tolower(pkg){found=1} END{exit !found}' \
        && return 0
    dotnet tool list --global 2>/dev/null \
        | awk -v cmd="$1" -v pkg="$2" \
            'tolower($3)==tolower(cmd) && tolower($1)==tolower(pkg){found=1} END{exit !found}' \
        && return 0
    return 1
}

require_dotnet_tool() {
    dotnet_tool_installed "$1" "$2" && return 0
    if is_ai_agent; then
        _repo=$(git rev-parse --show-toplevel 2>/dev/null)
        if [ -n "$_repo" ] && { [ -f "$_repo/.config/dotnet-tools.json" ] || [ -f "$_repo/dotnet-tools.json" ]; }; then
            die "dotnet-tools.json exists in this repository but $2 ($1) is not installed — add $2 to the manifest and run 'dotnet tool restore'. Do not install it directly."
        fi
        die "Required package ($2) is not installed so cannot run $1.  Operator needs to provide this to the environment.  Do not install it yourself"
    fi
    die "$1 ($2) dotnet tool is not installed"
}

require_dotnet_tool "$TOOL_CMD" "$TOOL_PKG"

REPO_ROOT=$(git rev-parse --show-toplevel)

# Collect .cs and .csproj files: every tracked one in all-files mode, staged
# ones only otherwise.
SCOPE_WORD=staged
[ "$MODE" = "all-files" ] && SCOPE_WORD=tracked
FMT_FILES=$(git_target_files '\.(cs|csproj)$')

if [ -z "$FMT_FILES" ]; then
    info "No ${SCOPE_WORD} .cs or .csproj files, skipping formatter"
    exit 0
fi

# Collect .cs files only (dotnet format does not apply to .csproj)
CS_FILES=$(printf '%s\n' "$FMT_FILES" | grep -E '\.cs$')

if [ -n "$CS_FILES" ]; then
    SOLUTION=$(find "$REPO_ROOT" -type f -iname "*.slnx" | head -1)
    [ -z "$SOLUTION" ] && SOLUTION=$(find "$REPO_ROOT" -type f -iname "*.sln" | head -1)

    if [ -z "$SOLUTION" ]; then
        info "No solution file found — skipping dotnet format"
    else
        dotnet format --version > /dev/null 2>&1 \
            || die "dotnet format is not available in this SDK (missing dotnet-format component): cannot format ${SCOPE_WORD} .cs files"

        set --
        while IFS= read -r f; do
            set -- "$@" "${REPO_ROOT}/${f}"
        done <<EOF
$CS_FILES
EOF
        info "Applying dotnet format to ${SCOPE_WORD} .cs files..."
        dotnet format "$SOLUTION" --include "$@" || die "dotnet format failed"

        # Re-stage all files formatted by dotnet format
        git add "$@"

        success "dotnet format applied and staged"
    fi
fi

# Build full paths as positional parameters for a single cscleanup invocation
set --
while IFS= read -r f; do
    set -- "$@" "${REPO_ROOT}/${f}"
done <<EOF
$FMT_FILES
EOF

info "Applying cscleanup formatting to ${SCOPE_WORD} .cs and .csproj files..."
dotnet cscleanup "$@" || die "cscleanup format failed"

# Re-stage all formatted files in one git add call
git add "$@"

success "cscleanup formatting applied and staged"
