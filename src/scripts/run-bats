#!/bin/bash
# Wrapper for bats: runs the complete bats suite under test/ when a change
# could affect it. Usage:
#   run-bats <file>...     run if any file qualifies (see _bats_file_qualifies)
#   run-bats --all-files   run if any tracked file qualifies
#   run-bats               run unconditionally (for callers that filter files
#                          themselves, e.g. a pass_filenames: false hook)
# Filenames only decide whether to run; the whole suite always runs, never
# just the named files. Exits 0 without running when test/ holds no *.bats
# file, so the hook is a cheap no-op in repos without a bats suite.
# Must be bash (not sh) so that export -f can propagate bats_readlinkf to the
# inner bats process (needed on platforms where the bats wrapper does not export it).

die() {
    printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    exit 1
}

command -v bats > /dev/null 2>&1 || die "bats is not installed — run ./install-deps-debian or ./install-deps-arch"

# bats 1.10.x (Ubuntu 24.04) does not export bats_readlinkf from the wrapper
# when run from a sh parent process. Without it, the bats library falls back to
# using the CWD as BATS_LIBEXEC, then bats-exec-file cannot find bats-exec-test.
# Defining and exporting it here ensures the inner bats library always resolves
# its own path correctly.
bats_readlinkf() { readlink -f "$1"; }
export -f bats_readlinkf

# bats 1.10.x does not reset per-run tmpdir variables on startup, so inherited
# values from an outer bats process cause directory-creation conflicts.
# Unsetting all four forces a completely fresh tmpdir hierarchy.
unset BATS_RUN_TMPDIR BATS_SUITE_TMPDIR BATS_FILE_TMPDIR BATS_TEST_TMPDIR

REPO_ROOT=$(git rev-parse --show-toplevel)

# No bats suite in this repo: nothing to run.
[ -n "$(find "$REPO_ROOT/test" -name '*.bats' -print -quit 2>/dev/null)" ] || exit 0

# A file qualifies when it is a shell script shellcheck supports (by
# extension, shebang or first-line `# shellcheck shell=` directive; the
# shared test/test_helper.bash qualifies by its extension) or this repo's own
# pre-commit config. $1 is the path as
# named (for extension/path matching); $2 is where to read it from.
# Extension and path are checked first so the first line is read only when
# they do not already decide it.
_bats_file_qualifies() {
    local name="$1" path="$2" first=""
    case "$name" in
        src/.pre-commit-config.yaml) return 0 ;;
        *.sh | *.bash | *.bats | *.ksh | *.dash) return 0 ;;
    esac
    [ -f "$path" ] || return 1
    # Bounded read: a shebang or directive fits well within 256 characters,
    # and an unbounded read would pull in the whole first line of a
    # single-line file such as minified JS or JSON.
    # A failed read leaves $first empty, so both patterns below fail.
    IFS= read -r -n 256 first < "$path"
    # Shebang: an interpreter in /bin, /usr/bin or /usr/local/bin, directly or
    # via `env` / `env -S`, naming sh, bash, dash, ksh or `busybox sh`.
    [[ "$first" =~ ^#![[:space:]]*(/usr(/local)?)?/bin/(env[[:space:]]+(-S[[:space:]]*)?)?(sh|bash|dash|ksh|busybox[[:space:]]+sh)([[:space:]]|$) ]] && return 0
    [[ "$first" =~ ^#[[:space:]]*shellcheck[[:space:]]+(.*[[:space:]])?shell=(sh|bash|dash|ksh|busybox)([[:space:]]|$) ]] && return 0
    return 1
}

if [ "$#" -gt 0 ]; then
    _bats_read_prefix=""
    if [ "$1" = "--all-files" ]; then
        # git -C prints repo-root-relative paths, so read them from REPO_ROOT
        # whatever the caller's cwd.
        mapfile -t _bats_candidates < <(git -C "$REPO_ROOT" ls-files)
        _bats_read_prefix="$REPO_ROOT/"
    else
        _bats_candidates=("$@")
    fi

    _bats_any_qualifies() {
        local file
        for file in "${_bats_candidates[@]}"; do
            _bats_file_qualifies "$file" "$_bats_read_prefix$file" && return 0
        done
        return 1
    }
    _bats_any_qualifies || exit 0
fi

# Sweep stale bats-run dirs from /tmp: removes litter left by hard-killed
# runs that predate the repo-scoped XDG_RUNTIME_DIR path, and from the /tmp
# fallback path used on hosts without XDG_RUNTIME_DIR. Done only once the
# suite is going to run, so no-op invocations stay cheap.
find /tmp -maxdepth 1 -name 'bats-run-*' -mmin +60 -exec rm -rf {} + 2>/dev/null

# bats reads TMPDIR at startup to derive BATS_TMPDIR; TMPDIR is the only lever
# that works — pre-setting BATS_TMPDIR here would be overwritten by bats itself.
#
# Prefer a predictable, repo-scoped path under XDG_RUNTIME_DIR (per-user tmpfs,
# usually /run/user/<uid>) which can be wiped and recreated before each run,
# guaranteeing a clean slate every time without an age-based sweep.
# Fall back to /tmp when XDG_RUNTIME_DIR is absent, not a writable directory,
# or would yield an unsafe path component (empty, `.`, or `..`).
_bats_resolve_tmpdir() {
    local xdg="${XDG_RUNTIME_DIR:-}"
    if ! { [ -d "$xdg" ] && [ -w "$xdg" ]; }; then
        printf '/tmp'
        return
    fi

    # Extract owner/repo from the git remote; strip any trailing .git suffix.
    local remote owner repo
    remote=$(git remote get-url origin 2>/dev/null || true)
    if [[ "$remote" =~ [:/]([^/:]+)/([^/]+)$ ]]; then
        owner="${BASH_REMATCH[1]}"
        repo="${BASH_REMATCH[2]%.git}"
    else
        owner="_local"
        repo=$(basename "$REPO_ROOT")
    fi

    # Reject empty or path-traversal components before using them in a path.
    if [[ -z "$owner" || "$owner" == '.' || "$owner" == '..' ||
          -z "$repo"  || "$repo"  == '.' || "$repo"  == '..' ]]; then
        printf '/tmp'
        return
    fi

    local candidate="$xdg/$owner/$repo/bats"

    # AF_UNIX sun_path allows 107 usable bytes (108 including the NUL
    # terminator). Reserve headroom for what gets nested under TMPDIR at
    # runtime: bats-core's own /bats-run-XXXXXX/test/NNNN (up to ~26 bytes),
    # a consuming repo's own mktemp layer such as /oneshot.XXXXXX (~15 bytes),
    # and a realistic mock-socket filename such as /S.gpg-agent.extra
    # (~18 bytes) — ~59 bytes worst case, observed directly in #169. A long
    # owner/repo name (or an unusually long ambient XDG_RUNTIME_DIR) can
    # otherwise produce a TMPDIR with no room left for what a test appends —
    # fall back to /tmp rather than hand back a base path that later socket
    # binds fail against.
    local -r _sun_path_usable_max=107
    local -r _nested_overhead_reserve=65
    local -r _max_candidate_len=$((_sun_path_usable_max - _nested_overhead_reserve))
    if [ "${#candidate}" -gt "$_max_candidate_len" ]; then
        printf '/tmp'
        return
    fi

    printf '%s' "$candidate"
}

BATS_RESOLVED_TMPDIR=$(_bats_resolve_tmpdir)

# When using the repo-specific XDG_RUNTIME_DIR path, wipe and recreate it so
# every run starts from a clean slate — stale fixtures from any prior hard-killed
# run are removed before bats even starts.
if [ "$BATS_RESOLVED_TMPDIR" != "/tmp" ]; then
    rm -rf "$BATS_RESOLVED_TMPDIR"
    mkdir -p "$BATS_RESOLVED_TMPDIR"
fi

export TMPDIR="$BATS_RESOLVED_TMPDIR"

# GNU parallel is bats' own prerequisite for --jobs; without it (or without a
# usable CPU count) fall through to today's unmodified serial run rather than
# failing. The job count is min(nproc, 8) - capped, not a raw core-count
# passthrough, since this script ships to every consumer repo on unknown
# hardware - and a computed count of 1 is skipped so a single-core/low-core
# host doesn't pay GNU parallel's overhead for zero actual parallelism.
# Deliberately not passing --no-parallelize-within-files: consumer repos'
# slow tests are typically concentrated inside a handful of files, not
# spread across many.
BATS_JOBS_ARGS=()
if command -v parallel > /dev/null 2>&1; then
    CPU_COUNT=$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 0)
    case "$CPU_COUNT" in ('' | *[!0-9]*) CPU_COUNT=0 ;; esac
    [ "$CPU_COUNT" -gt 8 ] && CPU_COUNT=8
    [ "$CPU_COUNT" -gt 1 ] && BATS_JOBS_ARGS=(--jobs "$CPU_COUNT")
fi

exec bats "${BATS_JOBS_ARGS[@]}" --recursive "$REPO_ROOT/test"
