#!/bin/bash
# Wrapper for bats: runs the bats tests under test/ that a change could
# affect. Usage:
#   run-bats <file>...     run the tests affected by the qualifying files
#                          (see _bats_file_qualifies, _bats_map_file,
#                          _bats_is_sourced and
#                          _bats_staged_deletion_qualifies)
#   run-bats --all-files   run the whole suite if any tracked file qualifies
#   run-bats               run the whole suite unconditionally (for callers
#                          that filter files themselves, e.g. a
#                          pass_filenames: false hook)
# When a qualifying file cannot be narrowed down, or RUN_BATS_FULL=1 is set,
# the whole suite runs instead; run-bats exits 0 without running when test/
# holds no *.bats file. README.md, "Bats test selection (run-bats)", is the
# full and authoritative description of which files qualify and which tests
# they run.
# Must be bash (not sh) so that export -f can propagate bats_readlinkf to the
# inner bats process (needed on platforms where the bats wrapper does not export it).

die() {
    printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    exit 1
}

command -v bats > /dev/null 2>&1 || die "bats is not installed — run ./install-deps-debian or ./install-deps-arch"

# bats 1.10.x (Ubuntu 24.04) does not export bats_readlinkf from the wrapper
# when run from a sh parent process. Without it, the bats library falls back to
# using the CWD as BATS_LIBEXEC, then bats-exec-file cannot find bats-exec-test.
# Defining and exporting it here ensures the inner bats library always resolves
# its own path correctly.
bats_readlinkf() { readlink -f "$1"; }
export -f bats_readlinkf

# bats 1.10.x does not reset per-run tmpdir variables on startup, so inherited
# values from an outer bats process cause directory-creation conflicts.
# Unsetting all four forces a completely fresh tmpdir hierarchy.
unset BATS_RUN_TMPDIR BATS_SUITE_TMPDIR BATS_FILE_TMPDIR BATS_TEST_TMPDIR

REPO_ROOT=$(git rev-parse --show-toplevel)

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=src/scripts/lib/mode-arg.sh
. "$SCRIPT_DIR/lib/mode-arg.sh"

# No bats suite in this repo: nothing to run.
[ -n "$(find "$REPO_ROOT/test" -name '*.bats' -print -quit 2>/dev/null)" ] || exit 0

# A file qualifies when it is a shell script shellcheck supports (by
# extension, shebang or first-line `# shellcheck shell=` directive; the
# shared test/test_helper.bash qualifies by its extension) or this repo's own
# pre-commit config. Extension and path are checked first so the first line
# is read only when they do not already decide it.
_bats_name_qualifies() {
    case "$1" in
        src/.pre-commit-config.yaml) return 0 ;;
        *.sh | *.bash | *.bats | *.ksh | *.dash) return 0 ;;
    esac
    return 1
}

# Succeeds when the first line $1 is a shebang (an interpreter in /bin,
# /usr/bin or /usr/local/bin, directly or via `env` / `env -S`, naming sh,
# bash, dash, ksh or `busybox sh`) or a `# shellcheck shell=` directive.
_bats_first_line_qualifies() {
    [[ "$1" =~ ^#![[:space:]]*(/usr(/local)?)?/bin/(env[[:space:]]+(-S[[:space:]]*)?)?(sh|bash|dash|ksh|busybox[[:space:]]+sh)([[:space:]]|$) ]] && return 0
    [[ "$1" =~ ^#[[:space:]]*shellcheck[[:space:]]+(.*[[:space:]])?shell=(sh|bash|dash|ksh|busybox)([[:space:]]|$) ]]
}

_bats_file_qualifies() {
    local path="$1" first=""
    _bats_name_qualifies "$path" && return 0
    [ -f "$path" ] || return 1
    # Bounded read: a shebang or directive fits well within 256 characters,
    # and an unbounded read would pull in the whole first line of a
    # single-line file such as minified JS or JSON.
    # A failed read leaves $first empty, so neither pattern matches.
    IFS= read -r -n 256 first < "$path"
    _bats_first_line_qualifies "$first"
}

# Succeeds when the staged deletion $1 (a repo-root-relative path) could
# break a test: any file under test/, a file that qualifies by name, or a
# file whose first line in HEAD (where every staged deletion still exists)
# qualifies. A HEAD blob that cannot be read (missing from the object store
# in a partial clone or a damaged repository) counts as qualifying, since its
# first line is unknown.
_bats_deleted_file_qualifies() {
    local path="$1" first="" status
    case "$path" in
        test/*) return 0 ;;
    esac
    _bats_name_qualifies "$path" && return 0
    IFS= read -r -n 256 first < <(git -C "$REPO_ROOT" cat-file blob "HEAD:$path" 2>/dev/null)
    wait "$!"
    status=$?
    # 141 (SIGPIPE): git was still writing a blob longer than the bounded
    # read when the read finished, so the first line was read in full.
    case "$status" in
        0 | 141) ;;
        *) return 0 ;;
    esac
    _bats_first_line_qualifies "$first"
}

# pre-commit passes no deleted file to a hook, so the tests of a deleted
# script (or a deleted test helper) would never be selected by name. Succeeds
# when a staged deletion could break a test, or when the index cannot be read,
# so the caller runs the whole suite. A rename counts as a deletion of its
# old name (see git_staged_deletions), which breaks that name's tests the
# same way.
_bats_staged_deletion_qualifies() {
    local path
    local -a deleted
    mapfile -d '' -t deleted < <(git_staged_deletions 2>/dev/null)
    wait "$!" || return 0
    for path in "${deleted[@]}"; do
        _bats_deleted_file_qualifies "$path" && return 0
    done
    return 1
}

_bats_targets=()
declare -A _bats_seen=()

_bats_add_target() {
    [ -n "${_bats_seen[$1]:-}" ] && return 0
    _bats_seen[$1]=1
    _bats_targets+=("$1")
}

# Every line of the repo's tracked and untracked (not ignored) files that
# sources a file: a `source` or `.` command at command position (line start,
# or after `;`, `&`, `|`, `(`, `{`, `then`, `do` or `else`), or a
# `# shellcheck source=` directive. Read once, on first use, by
# _bats_is_sourced.
_bats_source_lines=""
_bats_source_lines_read=0

# Succeeds when a source line names the basename $1, so the file is a library
# whose tests run through the scripts that source it, which no basename
# search finds. The basename must stand alone in the line (preceded by a
# start of line, space, `/`, `=` or quote, and followed by an end of line,
# space, quote, `;` or `)`), so `x.sh` does not match `lib/xx.sh`.
_bats_is_sourced() {
    if [ "$_bats_source_lines_read" = 0 ]; then
        _bats_source_lines=$(git -C "$REPO_ROOT" grep --untracked -h -I -E \
            -e '(^[[:space:]]*|[;&|({][[:space:]]*|(^|[[:space:]])(then|do|else)[[:space:]]+)(source|\.)[[:space:]]' \
            -e '#[[:space:]]*shellcheck[[:space:]]+(.*[[:space:]])?source=' 2>/dev/null)
        _bats_source_lines_read=1
    fi
    local -r before='(^|[[:space:]/="'\''])' after='([[:space:]";'\'')]|$)'
    [[ "$_bats_source_lines" =~ $before"$1"$after ]]
}

# Adds the bats files affected by one qualifying file to _bats_targets.
# Returns 1 when the file cannot be narrowed down, so the whole suite must run.
_bats_map_file() {
    local rel base stem found=0 hit
    local -a hits
    # -m: a deleted or renamed file no longer exists but still maps by name.
    rel=$(realpath -m --relative-to="$REPO_ROOT" -- "$1") || return 1
    case "$rel" in
        .. | ../*) return 1 ;;
        src/.pre-commit-config.yaml) return 1 ;;
        test/*.bats)
            [ -f "$REPO_ROOT/$rel" ] || return 1
            _bats_add_target "$REPO_ROOT/$rel"
            return 0
            ;;
        test/* | *.bats) return 1 ;;
    esac

    base=${rel##*/}
    _bats_is_sourced "$base" && return 1
    stem=${base%.*}
    if [ -n "$stem" ] && [ -f "$REPO_ROOT/test/$stem.bats" ]; then
        _bats_add_target "$REPO_ROOT/test/$stem.bats"
        found=1
    fi
    # The repo-relative path always contains the basename, so searching for the
    # basename finds both. grep reads the working tree, so untracked tests count.
    mapfile -d '' -t hits < <(grep -rlZ -F --include='*.bats' -e "$base" -- "$REPO_ROOT/test" 2>/dev/null)
    for hit in "${hits[@]}"; do
        _bats_add_target "$hit"
        found=1
    done
    [ "$found" = 1 ]
}

# An empty _bats_targets means the whole suite runs: no arguments,
# --all-files, RUN_BATS_FULL=1, or a file that cannot be narrowed down.
if [ "$#" -gt 0 ]; then
    _bats_narrow=0
    if [ "$1" = "--all-files" ]; then
        # git ls-files prints repo-root-relative paths, so read them from
        # REPO_ROOT whatever the caller's cwd. -z gives each path verbatim:
        # without it git C-quotes non-ASCII or quote-containing names, which
        # then match no extension and name no file.
        cd "$REPO_ROOT" || exit 1
        mapfile -d '' -t _bats_candidates < <(git ls-files -z)
    else
        _bats_candidates=("$@")
        [ "${RUN_BATS_FULL:-}" = 1 ] || _bats_narrow=1
    fi

    # One pass: the first qualifying file is enough when the whole suite runs
    # anyway, and a file that cannot be narrowed down falls back to it (that
    # file qualified, so the suite still runs).
    _bats_qualified=0
    # A staged deletion that could break a test runs the whole suite, even
    # when no passed file qualifies, since nothing else would run its tests.
    if [ "$_bats_narrow" = 1 ] && _bats_staged_deletion_qualifies; then
        _bats_qualified=1
        _bats_candidates=()
    fi
    for _bats_file in "${_bats_candidates[@]}"; do
        _bats_file_qualifies "$_bats_file" || continue
        _bats_qualified=1
        [ "$_bats_narrow" = 1 ] || break
        _bats_map_file "$_bats_file" && continue
        _bats_targets=()
        break
    done
    [ "$_bats_qualified" = 1 ] || exit 0
fi

# Sweep stale bats-run dirs from /tmp: removes litter left by hard-killed
# runs that predate the repo-scoped XDG_RUNTIME_DIR path, and from the /tmp
# fallback path used on hosts without XDG_RUNTIME_DIR. Done only once the
# suite is going to run, so no-op invocations stay cheap.
find /tmp -maxdepth 1 -name 'bats-run-*' -mmin +60 -exec rm -rf {} + 2>/dev/null

# bats reads TMPDIR at startup to derive BATS_TMPDIR; TMPDIR is the only lever
# that works — pre-setting BATS_TMPDIR here would be overwritten by bats itself.
#
# Prefer a predictable, repo-scoped path under XDG_RUNTIME_DIR (per-user tmpfs,
# usually /run/user/<uid>) which can be wiped and recreated before each run,
# guaranteeing a clean slate every time without an age-based sweep.
# Fall back to /tmp when XDG_RUNTIME_DIR is absent, not a writable directory,
# or would yield an unsafe path component (empty, `.`, or `..`).
_bats_resolve_tmpdir() {
    local xdg="${XDG_RUNTIME_DIR:-}"
    if ! { [ -d "$xdg" ] && [ -w "$xdg" ]; }; then
        printf '/tmp'
        return
    fi

    # Extract owner/repo from the git remote; strip any trailing .git suffix.
    local remote owner repo
    remote=$(git remote get-url origin 2>/dev/null || true)
    if [[ "$remote" =~ [:/]([^/:]+)/([^/]+)$ ]]; then
        owner="${BASH_REMATCH[1]}"
        repo="${BASH_REMATCH[2]%.git}"
    else
        owner="_local"
        repo=$(basename "$REPO_ROOT")
    fi

    # Reject empty or path-traversal components before using them in a path.
    if [[ -z "$owner" || "$owner" == '.' || "$owner" == '..' ||
          -z "$repo"  || "$repo"  == '.' || "$repo"  == '..' ]]; then
        printf '/tmp'
        return
    fi

    local candidate="$xdg/$owner/$repo/bats"

    # AF_UNIX sun_path allows 107 usable bytes (108 including the NUL
    # terminator). Reserve headroom for what gets nested under TMPDIR at
    # runtime: bats-core's own /bats-run-XXXXXX/test/NNNN (up to ~26 bytes),
    # a consuming repo's own mktemp layer such as /oneshot.XXXXXX (~15 bytes),
    # and a realistic mock-socket filename such as /S.gpg-agent.extra
    # (~18 bytes) — ~59 bytes worst case, observed directly in #169. A long
    # owner/repo name (or an unusually long ambient XDG_RUNTIME_DIR) can
    # otherwise produce a TMPDIR with no room left for what a test appends —
    # fall back to /tmp rather than hand back a base path that later socket
    # binds fail against.
    local -r _sun_path_usable_max=107
    local -r _nested_overhead_reserve=65
    local -r _max_candidate_len=$((_sun_path_usable_max - _nested_overhead_reserve))
    if [ "${#candidate}" -gt "$_max_candidate_len" ]; then
        printf '/tmp'
        return
    fi

    printf '%s' "$candidate"
}

BATS_RESOLVED_TMPDIR=$(_bats_resolve_tmpdir)

# When using the repo-specific XDG_RUNTIME_DIR path, wipe and recreate it so
# every run starts from a clean slate — stale fixtures from any prior hard-killed
# run are removed before bats even starts.
if [ "$BATS_RESOLVED_TMPDIR" != "/tmp" ]; then
    rm -rf "$BATS_RESOLVED_TMPDIR"
    mkdir -p "$BATS_RESOLVED_TMPDIR"
fi

export TMPDIR="$BATS_RESOLVED_TMPDIR"

# GNU parallel is bats' own prerequisite for --jobs; without it (or without a
# usable CPU count) fall through to today's unmodified serial run rather than
# failing. The job count is min(nproc, 8) - capped, not a raw core-count
# passthrough, since this script ships to every consumer repo on unknown
# hardware - and a computed count of 1 is skipped so a single-core/low-core
# host doesn't pay GNU parallel's overhead for zero actual parallelism.
# Deliberately not passing --no-parallelize-within-files: consumer repos'
# slow tests are typically concentrated inside a handful of files, not
# spread across many.
BATS_JOBS_ARGS=()
if command -v parallel > /dev/null 2>&1; then
    CPU_COUNT=$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 0)
    case "$CPU_COUNT" in ('' | *[!0-9]*) CPU_COUNT=0 ;; esac
    [ "$CPU_COUNT" -gt 8 ] && CPU_COUNT=8
    [ "$CPU_COUNT" -gt 1 ] && BATS_JOBS_ARGS=(--jobs "$CPU_COUNT")
fi

if [ "${#_bats_targets[@]}" -gt 0 ]; then
    exec bats "${BATS_JOBS_ARGS[@]}" --print-output-on-failure "${_bats_targets[@]}"
fi

exec bats "${BATS_JOBS_ARGS[@]}" --print-output-on-failure --recursive "$REPO_ROOT/test"
