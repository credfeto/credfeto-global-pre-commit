#!/bin/sh
# Normalises staged package-lock.json files by replacing private npm registry
# URLs with the public registry URL.
#
# This fixes lock files that were generated while a custom registry was
# configured globally (e.g. https://npm.markridgwell.com/), ensuring the
# committed lock file always points to the public registry.
#
# Works for package-lock.json files at any depth in the repository.
# Modified files are automatically re-staged so the fix is included in
# the current commit.
#
# Usage: clean-package-lock-registry [--all-files]
#
# --all-files mode (invoked by hooks/pre-commit's own --all-files mode) has
# no commit in progress: it targets every tracked package-lock.json (git
# ls-files) instead of only staged ones, still re-staging anything it
# modifies -- the whole point of --all-files is a detect-and-fix baseline
# pass, not just a report.

die() {
    printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    exit 1
}

info() {
    printf '\n\033[32m→\033[0m %s\n' "$*"
}

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=src/scripts/lib/mode-arg.sh
. "$SCRIPT_DIR/lib/mode-arg.sh"
parse_all_files_mode_arg "$1"

sed_inplace() {
    # Applies a sed substitution in-place using the correct flag for the
    # platform (GNU sed uses -i, BSD sed requires -i ''), then re-stages.
    if sed --version > /dev/null 2>&1; then
        sed -i "$1" "$2"
    else
        sed -i '' "$1" "$2"
    fi
    git add "$2"
}

command -v sed > /dev/null 2>&1 || die "sed is not installed."

LOCK_FILES=$(git_target_files '(^|/)package-lock\.json$')
[ -z "$LOCK_FILES" ] && exit 0

FOUND=0
while IFS= read -r file; do
    [ -f "$file" ] || continue
    grep -q "npm.markridgwell.com" "$file" || continue
    info "Normalising registry URL in $file"
    sed_inplace "s|https://npm\.markridgwell\.com/|https://registry.npmjs.org/|g" "$file"
    FOUND=1
done << EOF
$LOCK_FILES
EOF

[ "$FOUND" -eq 1 ] && info "package-lock.json registry URLs normalised and re-staged."
exit 0
