#!/bin/sh
# Entry point for the acceptance test suite.
# Delegates to bats; see test/*.bats for the individual tests.

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
HOOK="${REPO_DIR}/src/hooks/pre-commit"

die() {
    printf '\033[31m✗\033[0m %s\n' "$*" >&2
    exit 1
}

[ -x "${HOOK}" ] || die "hook not found or not executable: ${HOOK}"
command -v git > /dev/null 2>&1 || die "git is not installed"
command -v bats > /dev/null 2>&1 || die "bats is not installed — run ./install-deps-debian or ./install-deps-arch"

# GNU parallel is bats' own prerequisite for --jobs; without it (or without a
# usable CPU count) fall through to today's unmodified serial run rather than
# failing. The job count is min(nproc, 8) - capped, not a raw core-count
# passthrough - and a computed count of 1 is skipped so a low-core host
# doesn't pay GNU parallel's overhead for zero actual parallelism.
# Deliberately not passing --no-parallelize-within-files: this repo's own
# slow tests are concentrated inside a handful of files (see #211), not
# spread across many.
BATS_JOBS=""
if command -v parallel > /dev/null 2>&1; then
    CPU_COUNT=$(nproc 2>/dev/null) || CPU_COUNT=$(getconf _NPROCESSORS_ONLN 2>/dev/null) || CPU_COUNT=0
    case "$CPU_COUNT" in (*[!0-9]*) CPU_COUNT=0 ;; esac
    if [ "$CPU_COUNT" -ge 1 ] 2>/dev/null; then
        BATS_JOBS="$CPU_COUNT"
        [ "$BATS_JOBS" -gt 8 ] && BATS_JOBS=8
        [ "$BATS_JOBS" -gt 1 ] || BATS_JOBS=""
    fi
fi

set -- --print-output-on-failure --recursive "${REPO_DIR}/test"
[ -n "$BATS_JOBS" ] && set -- --jobs "$BATS_JOBS" "$@"
exec bats "$@"
