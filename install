#!/bin/sh
# Install global git pre-commit hooks from this repo.
# Sets core.hooksPath globally so every repo on this machine uses these hooks.
# Run once after cloning; re-run after pulling updates.
# Pass --system to install for all users (requires sudo for git config --system).

set -e

die() {
    if [ -t 2 ]; then
        printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    else
        printf '\n✗ %s\n' "$*" >&2
    fi
    exit 1
}

SYSTEM_INSTALL=false
for _arg in "$@"; do
    case "$_arg" in
        --system) SYSTEM_INSTALL=true ;;
        *) die "Unknown argument: $_arg" ;;
    esac
done

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
HOOKS_DIR="$REPO_DIR/src/hooks"
SCRIPTS_DIR="$REPO_DIR/src/scripts"

# ── Refuse cross-scope install ────────────────────────────────────────────────
# Installing at one scope while the other already has a hooksPath configured
# would leave two conflicting installs in place, so require the existing one
# removed first rather than silently layering another on top.
if $SYSTEM_INSTALL; then
    _other_scope=global
    _other_hooks_path=$(git config --global --get core.hooksPath 2>/dev/null || true)
else
    _other_scope=system
    _other_hooks_path=$(git config --system --get core.hooksPath 2>/dev/null || true)
fi
if [ -n "$_other_hooks_path" ]; then
    die "Refusing to install: a ${_other_scope} core.hooksPath is already configured (${_other_hooks_path}).
Remove it first with: git config --${_other_scope} --unset core.hooksPath"
fi

# ── Make everything executable ────────────────────────────────────────────────
chmod +x \
    "$HOOKS_DIR/pre-commit" \
    "$HOOKS_DIR/pre-push" \
    "$SCRIPTS_DIR/buildtest" \
    "$SCRIPTS_DIR/benchmark-test-affected" \
    "$SCRIPTS_DIR/latest-target-framework" \
    "$SCRIPTS_DIR/dacpac-only-solution" \
    "$SCRIPTS_DIR/buildcheck" \
    "$SCRIPTS_DIR/run-formatter" \
    "$SCRIPTS_DIR/check-changelog" \
    "$SCRIPTS_DIR/check-identity" \
    "$SCRIPTS_DIR/check-ignored-files" \
    "$SCRIPTS_DIR/check-funfair-props" \
    "$SCRIPTS_DIR/check-merge-commits" \
    "$SCRIPTS_DIR/clean-package-lock-registry" \
    "$SCRIPTS_DIR/check-msbuild-path-separator" \
    "$SCRIPTS_DIR/run-eslint" \
    "$SCRIPTS_DIR/run-stylelint" \
    "$SCRIPTS_DIR/run-psscriptanalyzer" \
    "$SCRIPTS_DIR/run-bats" \
    "$SCRIPTS_DIR/run-pylint" \
    "$SCRIPTS_DIR/run-shellcheck-libraries" \
    "$REPO_DIR/check-setup" \
    "$REPO_DIR/acceptance-test" \
    "$REPO_DIR/install-deps-arch" \
    "$REPO_DIR/install-deps-debian"

# ── System git config helpers ────────────────────────────────────────────────
# Prints the system git config's path, or nothing when it is missing or has no
# entries. The path is asked of git as root because a non-root read fails on
# exactly the unreadable file this script repairs. -z prints the origin raw
# rather than C-quoted, and --system does not follow includes, so the first
# origin is always the system file itself. git var GIT_CONFIG_SYSTEM would be
# simpler but needs git 2.42, newer than Ubuntu 22.04 and Debian 12 ship.
system_git_config_path() {
    sudo git config --system --show-origin -z --list \
        | tr '\0' '\n' | sed -n '1s/^file://p'
}

# sudo keeps the caller's umask, so a restrictive one (e.g. 027) creates the
# system config unreadable by other users, and git keeps an existing file's
# mode on rewrite, so only an explicit chmod makes it readable again.
make_system_git_config_world_readable() {
    sudo chmod 0644 "$1" \
        || die "Failed to make the system git config ($1) world-readable"
}

# ── Repair an unreadable system git config ───────────────────────────────────
# The dependency step runs git as the user (paru/yay clone AUR packages, the
# nvm installer clones with git), and git dies on a system config it cannot
# read, so one left unreadable by an earlier install is repaired first. A
# missing file also fails the read, but then has no path and needs no repair.
if $SYSTEM_INSTALL && command -v git > /dev/null 2>&1 \
    && ! git config --system --list > /dev/null 2>&1; then
    SYSTEM_GIT_CONFIG=$(system_git_config_path 2>/dev/null)
    if [ -n "$SYSTEM_GIT_CONFIG" ]; then
        make_system_git_config_world_readable "$SYSTEM_GIT_CONFIG"
    fi
fi

# ── Install platform dependencies ─────────────────────────────────────────────
distro_family() {
    [ -f /etc/os-release ] || return 0
    _id=$(grep '^ID=' /etc/os-release | cut -d= -f2- | tr -d '"')
    _like=$(grep '^ID_LIKE=' /etc/os-release | cut -d= -f2- | tr -d '"')
    case "$_id $_like" in
        *arch*)            printf 'arch' ;;
        *debian*|*ubuntu*) printf 'debian' ;;
    esac
}

DISTRO=$(distro_family)
case "$DISTRO" in
    arch)
        echo "Detected Arch-based Linux — running install-deps-arch..."
        "$REPO_DIR/install-deps-arch"
        ;;
    debian)
        echo "Detected Debian-based Linux — running install-deps-debian..."
        "$REPO_DIR/install-deps-debian"
        ;;
    *)
        echo "Platform not recognised — skipping dependency install."
        echo "Run ./install-deps-arch or ./install-deps-debian manually."
        ;;
esac

# ── Register with git ────────────────────────────────────────────────────────
if $SYSTEM_INSTALL; then
    sudo git config --system core.hooksPath "$HOOKS_DIR" \
        || die "Failed to set core.hooksPath in the system git config"
    # Made world-readable whatever this user can read, because every other
    # user of the machine needs to read it too.
    SYSTEM_GIT_CONFIG=$(system_git_config_path)
    [ -n "$SYSTEM_GIT_CONFIG" ] \
        || die "Failed to locate the system git config"
    make_system_git_config_world_readable "$SYSTEM_GIT_CONFIG"
else
    git config --global core.hooksPath "$HOOKS_DIR"
fi

# ── Symlink system-hook wrappers onto PATH ────────────────────────────────────
# These are called by pre-commit's local system hooks.
mkdir -p "$HOME/.local/bin"
ln -sf "$SCRIPTS_DIR/run-eslint"           "$HOME/.local/bin/run-eslint"
ln -sf "$SCRIPTS_DIR/run-stylelint"        "$HOME/.local/bin/run-stylelint"
ln -sf "$SCRIPTS_DIR/run-psscriptanalyzer" "$HOME/.local/bin/run-psscriptanalyzer"
ln -sf "$SCRIPTS_DIR/run-bats"             "$HOME/.local/bin/run-bats"
ln -sf "$SCRIPTS_DIR/run-pylint"           "$HOME/.local/bin/run-pylint"

# Go tools are installed to $GOPATH/bin which may not be on PATH — symlink them.
if command -v go > /dev/null 2>&1; then
    _gobin="$(go env GOPATH)/bin"
    [ -f "$_gobin/composite-action-lint" ] && \
        ln -sf "$_gobin/composite-action-lint" "$HOME/.local/bin/composite-action-lint"
fi

# ── Report setup status ───────────────────────────────────────────────────────
# Validates the pre-commit config and reports which checks/tools are available.
# check-setup exits non-zero when tools are missing, but install itself succeeds
# regardless — all listed tools are optional linters; the hooks still run without
# them (they are skipped per file type).  Run ./check-setup independently to
# verify a complete setup.
if $SYSTEM_INSTALL; then
    "$REPO_DIR/check-setup" --system || true
else
    "$REPO_DIR/check-setup" || true
fi
