#!/bin/sh
# Install global git pre-commit hooks from this repo.
# Sets core.hooksPath globally so every repo on this machine uses these hooks.
# Run once after cloning; re-run after pulling updates.
# Pass --system to install for all users (requires sudo for git config --system).

set -e

die() {
    if [ -t 2 ]; then
        printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    else
        printf '\n✗ %s\n' "$*" >&2
    fi
    exit 1
}

info() {
    if [ -t 1 ]; then
        printf '\n\033[32m→\033[0m %s\n' "$*"
    else
        printf '\n→ %s\n' "$*"
    fi
}

warn() {
    if [ -t 2 ]; then
        printf '\n\033[33m→\033[0m warning: %s\n' "$*" >&2
    else
        printf '\n→ warning: %s\n' "$*" >&2
    fi
}

SYSTEM_INSTALL=false
for _arg in "$@"; do
    case "$_arg" in
        --system) SYSTEM_INSTALL=true ;;
        *) die "Unknown argument: $_arg" ;;
    esac
done

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
HOOKS_DIR="$REPO_DIR/src/hooks"
SCRIPTS_DIR="$REPO_DIR/src/scripts"

# ── Refuse cross-scope install ────────────────────────────────────────────────
# Installing at one scope while the other already has a hooksPath configured
# would leave two conflicting installs in place, so require the existing one
# removed first rather than silently layering another on top. git config
# --get exits 1 when the key is unset, but a file it cannot read either makes
# it exit with another status or only warns on stderr and still exits 1, so
# an unset key is trusted only when git printed nothing: treating an
# unreadable config as unset would let the install layer on top of the one it
# should refuse. stderr is captured on its own, so a warning never becomes
# the hooksPath value, and the value is read only once the read is known
# clean. Without git, which the dependency step installs, no scope can be set.
#
# SYSTEM_GIT_CONFIG_FALLBACK_TEST_OVERRIDE is a test-only escape hatch, so the
# tests can exercise the fallback without touching the real /etc/gitconfig;
# never set it in production shells.
SYSTEM_GIT_CONFIG_FALLBACK="${SYSTEM_GIT_CONFIG_FALLBACK_TEST_OVERRIDE:-/etc/gitconfig}"
if $SYSTEM_INSTALL; then
    _other_scope=global
    _other_config="${GIT_CONFIG_GLOBAL:-$HOME/.gitconfig}"
else
    _other_scope=system
    _other_config="${GIT_CONFIG_SYSTEM:-$SYSTEM_GIT_CONFIG_FALLBACK}"
fi
_other_hooks_path=
if command -v git > /dev/null 2>&1; then
    _other_status=0
    _other_error=$(git config "--${_other_scope}" --get core.hooksPath 2>&1 > /dev/null) \
        || _other_status=$?
    if [ "$_other_status" -gt 1 ] || [ -n "$_other_error" ]; then
        die "Failed to read the ${_other_scope} git config (${_other_config}) to check for an existing core.hooksPath: ${_other_error:-git exited ${_other_status}}
Make it readable with: sudo chmod 644 ${_other_config}"
    fi
    if [ "$_other_status" -eq 0 ]; then
        _other_hooks_path=$(git config "--${_other_scope}" --get core.hooksPath)
    fi
fi
if [ -n "$_other_hooks_path" ]; then
    die "Refusing to install: a ${_other_scope} core.hooksPath is already configured (${_other_hooks_path}).
Remove it first with: git config --${_other_scope} --unset core.hooksPath"
fi

# ── Make everything executable ────────────────────────────────────────────────
# A root-owned --system copy is normally executable already, so only files the
# caller cannot execute are touched, and a --system install retries as root
# when the caller is not allowed to change one. A listed file missing from the
# checkout dies first, because the --system chmod hides its error and the sudo
# retry would otherwise report it as a permission failure.
make_executable() {
    for _file in "$@"; do
        [ -e "$_file" ] || die "$_file is missing from the checkout"
        if [ -x "$_file" ]; then
            continue
        fi
        if $SYSTEM_INSTALL; then
            chmod +x "$_file" 2> /dev/null \
                || sudo chmod +x "$_file" \
                || die "Failed to make $_file executable, even with sudo"
        else
            chmod +x "$_file" || die "Failed to make $_file executable"
        fi
    done
}

make_executable \
    "$HOOKS_DIR/pre-commit" \
    "$HOOKS_DIR/commit-msg" \
    "$HOOKS_DIR/pre-push" \
    "$SCRIPTS_DIR/buildtest" \
    "$SCRIPTS_DIR/benchmark-test-affected" \
    "$SCRIPTS_DIR/check-benchmark-project-names" \
    "$SCRIPTS_DIR/latest-target-framework" \
    "$SCRIPTS_DIR/dacpac-only-solution" \
    "$SCRIPTS_DIR/buildcheck" \
    "$SCRIPTS_DIR/check-changelog" \
    "$SCRIPTS_DIR/check-identity" \
    "$SCRIPTS_DIR/check-ignored-files" \
    "$SCRIPTS_DIR/check-funfair-props" \
    "$SCRIPTS_DIR/check-merge-commits" \
    "$SCRIPTS_DIR/check-reference-repo" \
    "$SCRIPTS_DIR/clean-package-lock-registry" \
    "$SCRIPTS_DIR/check-msbuild-path-separator" \
    "$SCRIPTS_DIR/run-eslint" \
    "$SCRIPTS_DIR/run-stylelint" \
    "$SCRIPTS_DIR/run-bats" \
    "$SCRIPTS_DIR/run-pylint" \
    "$SCRIPTS_DIR/run-shellcheck-libraries" \
    "$REPO_DIR/check-setup" \
    "$REPO_DIR/acceptance-test" \
    "$REPO_DIR/install-deps-arch" \
    "$REPO_DIR/install-deps-debian"

# ── System git config helpers ────────────────────────────────────────────────
# Sets SYSTEM_GIT_CONFIG to the system git config's path, whether or not the
# file exists, without ever starting an editor. sudo is checked on its own
# first, so a sudo failure dies naming sudo rather than being mistaken for a
# missing file or an older git. git is asked as root because a non-root read
# fails on exactly the unreadable file this script repairs, and -C / keeps the
# caller's working directory, and any repository ownership check there, out
# of the lookup. git var GIT_CONFIG_SYSTEM needs git 2.42, newer than Ubuntu
# 22.04 and Debian 12 ship; older git rejects it with a usage message, so its
# stderr is discarded and the distro git location is used instead.
locate_system_git_config() {
    sudo true || die "Failed to run sudo to locate the system git config"
    if ! SYSTEM_GIT_CONFIG=$(sudo git -C / var GIT_CONFIG_SYSTEM 2> /dev/null) \
        || [ -z "$SYSTEM_GIT_CONFIG" ]; then
        SYSTEM_GIT_CONFIG="$SYSTEM_GIT_CONFIG_FALLBACK"
    fi
}

# Succeeds when the system git config exists, checked as root because the
# directory holding it need not be readable by this user. Only meaningful
# after locate_system_git_config, which has already proved sudo works, so a
# failure here means the file is missing.
system_git_config_exists() {
    sudo test -e "$SYSTEM_GIT_CONFIG"
}

# sudo keeps the caller's umask, so a restrictive one (e.g. 027) creates the
# system config unreadable by other users, and git keeps an existing file's
# mode on rewrite, so only an explicit chmod makes it readable again. Only the
# read bits are added, so any other mode bits an admin chose are kept. chmod
# follows a symlink, so the mode changed is always that of the file git reads.
make_system_git_config_world_readable() {
    sudo chmod a+r "$1" \
        || die "Failed to make the system git config ($1) world-readable"
}

# ── Repair an unreadable system git config ───────────────────────────────────
# The dependency step can run git as the user (the nvm installer on Debian
# clones with git), and git dies on a system config it cannot
# read, so one left unreadable by an earlier install is repaired first. A
# missing file also fails the read, but needs no repair.
if $SYSTEM_INSTALL && command -v git > /dev/null 2>&1 \
    && ! git config --system --list > /dev/null 2>&1; then
    locate_system_git_config
    if system_git_config_exists; then
        make_system_git_config_world_readable "$SYSTEM_GIT_CONFIG"
    fi
fi

# ── Install platform dependencies ─────────────────────────────────────────────
# OS_RELEASE_TEST_OVERRIDE is a test-only escape hatch, so the tests pick the
# dependency step whatever the host is; never set it in production shells.
OS_RELEASE="${OS_RELEASE_TEST_OVERRIDE:-/etc/os-release}"
distro_family() {
    [ -f "$OS_RELEASE" ] || return 0
    _id=$(grep '^ID=' "$OS_RELEASE" | cut -d= -f2- | tr -d '"')
    _like=$(grep '^ID_LIKE=' "$OS_RELEASE" | cut -d= -f2- | tr -d '"')
    case "$_id $_like" in
        *arch*)            printf 'arch' ;;
        *debian*|*ubuntu*) printf 'debian' ;;
    esac
}

DISTRO=$(distro_family)
case "$DISTRO" in
    arch)
        info "Detected Arch-based Linux: running install-deps-arch..."
        "$REPO_DIR/install-deps-arch"
        ;;
    debian)
        info "Detected Debian-based Linux: running install-deps-debian..."
        "$REPO_DIR/install-deps-debian"
        ;;
    *)
        info "Platform not recognised: skipping dependency install.
Run ./install-deps-arch or ./install-deps-debian manually."
        ;;
esac

# ── Register with git ────────────────────────────────────────────────────────
if $SYSTEM_INSTALL; then
    sudo git config --system core.hooksPath "$HOOKS_DIR" \
        || die "Failed to set core.hooksPath in the system git config"
    # Made world-readable whatever this user can read, because every other
    # user of the machine needs to read it too.
    locate_system_git_config
    make_system_git_config_world_readable "$SYSTEM_GIT_CONFIG"
else
    git config --global core.hooksPath "$HOOKS_DIR"
fi

# ── Symlink system-hook wrappers onto PATH ────────────────────────────────────
# These are called by pre-commit's local system hooks. A --system install
# links none of them, because the shared hook puts its own src/scripts on
# PATH for every user.
if ! $SYSTEM_INSTALL; then
    mkdir -p "$HOME/.local/bin"
    ln -sf "$SCRIPTS_DIR/run-eslint"           "$HOME/.local/bin/run-eslint"
    ln -sf "$SCRIPTS_DIR/run-stylelint"        "$HOME/.local/bin/run-stylelint"
    ln -sf "$SCRIPTS_DIR/run-bats"             "$HOME/.local/bin/run-bats"
    ln -sf "$SCRIPTS_DIR/run-pylint"           "$HOME/.local/bin/run-pylint"
    # Wrappers that no longer exist: a link left by an earlier install, or
    # made by hand to a wrapper in this checkout, would otherwise dangle on
    # PATH. Only links are removed, never a file the user put there.
    for _retired in run-psscriptanalyzer run-formatter; do
        if [ -L "$HOME/.local/bin/$_retired" ]; then
            rm -f "$HOME/.local/bin/$_retired"
        fi
    done
fi

# SYSTEM_BIN_DIR_TEST_OVERRIDE is a test-only escape hatch, so the tests never
# write into the real /usr/local/bin; never set it in production shells.
SYSTEM_BIN_DIR="${SYSTEM_BIN_DIR_TEST_OVERRIDE:-/usr/local/bin}"

# Go tools are installed to $GOPATH/bin, which may not be on PATH. A --system
# install copies them rather than linking, because a link into the installing
# user's home directory is unreadable for every other user.
# A failed copy only warns, because composite-action-lint is optional and
# core.hooksPath is already set: check-setup then reports it missing.
if command -v go > /dev/null 2>&1; then
    _gobin="$(go env GOPATH)/bin"
    if [ -f "$_gobin/composite-action-lint" ]; then
        if $SYSTEM_INSTALL; then
            sudo install -m 0755 "$_gobin/composite-action-lint" "$SYSTEM_BIN_DIR/composite-action-lint" \
                || warn "Failed to install $_gobin/composite-action-lint into $SYSTEM_BIN_DIR"
        else
            ln -sf "$_gobin/composite-action-lint" "$HOME/.local/bin/composite-action-lint"
        fi
    fi
fi

# ── Report setup status ───────────────────────────────────────────────────────
# Validates the pre-commit config and reports which checks/tools are available.
# check-setup exits non-zero when tools are missing, but install itself succeeds
# regardless: all listed tools are optional linters; the hooks still run without
# them (they are skipped per file type).  Run ./check-setup independently to
# verify a complete setup.
if $SYSTEM_INSTALL; then
    "$REPO_DIR/check-setup" --system || true
else
    "$REPO_DIR/check-setup" || true
fi
