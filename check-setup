#!/bin/sh
# Health-check for the global pre-commit hooks setup.
# Validates the bundled pre-commit config and reports which checks and tools are
# available on this machine.
#
# Exit status:
#   0  the pre-commit config is valid AND every listed tool is installed
#   1  the config failed to validate OR one or more tools are missing
#
# Run standalone at any time, or automatically at the end of ./install.
# Pass --system when the hooks were installed system-wide: the pipx- and
# npm-installed tools must then be runnable by every user, not only from this
# user's $HOME.

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
HOOKS_DIR="$REPO_DIR/src/hooks"

SYSTEM_INSTALL=false
for _arg in "$@"; do
    case "$_arg" in
        --system) SYSTEM_INSTALL=true ;;
        *) printf 'Unknown argument: %s\n' "$_arg" >&2; exit 1 ;;
    esac
done

die() {
    if [ -t 2 ]; then
        printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    else
        printf '\n✗ %s\n' "$*" >&2
    fi
    exit 1
}

has() { command -v "$1" > /dev/null 2>&1; }

# Test-only override, so the suite never inspects the real shared pipx home.
PIPX_SHARED_HOME="${PIPX_SHARED_HOME_TEST_OVERRIDE:-/opt/pipx}"

# The command install-deps-arch/-debian's pipx_ensure runs, for package $1.
shared_pipx_hint() {
    printf "(umask 022 && sudo env PIPX_HOME=%s PIPX_BIN_DIR=/usr/local/bin PIPX_MAN_DIR=/usr/local/share/man pipx install %s) && sudo chmod -R a+rX %s" \
        "$PIPX_SHARED_HOME" "$1" "$PIPX_SHARED_HOME"
}

HOME_REAL=$(readlink -f "$HOME" 2>/dev/null || printf '%s' "$HOME")

is_under_home() {
    case "$1" in
        "$HOME"/*|"$HOME_REAL"/*) return 0 ;;
    esac
    return 1
}

# Prints the resolved path of the first copy of $1 on PATH that does not live
# under $HOME, failing when every copy does (or there is none).
shared_command_path() {
    _saved_ifs=$IFS
    IFS=:
    for _dir in $PATH; do
        [ -n "$_dir" ] || _dir=.
        [ -f "$_dir/$1" ] && [ -x "$_dir/$1" ] || continue
        _real=$(readlink -f "$_dir/$1") || continue
        if ! is_under_home "$_real"; then
            IFS=$_saved_ifs
            printf '%s\n' "$_real"
            return 0
        fi
    done
    IFS=$_saved_ifs
    return 1
}

# Succeeds when every user can enter each of the directories given.
dirs_searchable_by_all() {
    [ -z "$(find "$@" -prune ! -perm -o=x -print 2>/dev/null)" ]
}

# Succeeds when every user can use the file or directory tree $1: directories
# readable and searchable, files readable, and owner-executable files
# executable by all.
tree_usable_by_all() {
    [ -z "$(find "$1" \( -type d ! -perm -o=rx \) -o \( -type f ! -perm -o=r \) -o \( -type f -perm -u=x ! -perm -o=x \) 2>/dev/null | head -1)" ]
}

# Succeeds when pipx-installable tool $1 (from package $2) is usable by every
# user this install serves. Otherwise fails, printing why when it is installed
# but unusable by other users, and nothing when it is not installed at all.
# Without --system only this user matters, so being on PATH is enough.
pipx_tool_usable() {
    has "$1" || return 1
    $SYSTEM_INSTALL || return 0
    if ! _shared=$(shared_command_path "$1"); then
        printf 'installed only under %s, so other users cannot run it; run: %s' "$HOME" "$(shared_pipx_hint "$2")"
        return 1
    fi
    case "$_shared" in
        "$PIPX_SHARED_HOME"/venvs/*)
            _venv="${_shared#"$PIPX_SHARED_HOME"/venvs/}"
            _venv="$PIPX_SHARED_HOME/venvs/${_venv%%/*}"
            if ! dirs_searchable_by_all "$PIPX_SHARED_HOME" "$PIPX_SHARED_HOME/venvs" \
                || ! tree_usable_by_all "$_venv"; then
                printf '%s is not readable and executable by other users, so they cannot run it; run: %s' "$_venv" "$(shared_pipx_hint "$2")"
                return 1
            fi
            ;;
    esac
    return 0
}

# Test-only override, so the suite never inspects the real shared npm prefix.
NPM_SHARED_PREFIX="${NPM_SHARED_PREFIX_TEST_OVERRIDE:-/usr/local}"
NPM_SHARED_MODULES="$NPM_SHARED_PREFIX/lib/node_modules"

# The command install-deps-arch/-debian's install_npm_globals runs, for the
# package(s) in $1.
shared_npm_hint() {
    printf "(umask 022 && sudo npm install --global --prefix %s --engine-strict --ignore-scripts %s) && sudo chmod -R a+rX %s" \
        "$NPM_SHARED_PREFIX" "$1" "$NPM_SHARED_MODULES"
}

SHARED_NODE_HINT="./install-deps-arch or ./install-deps-debian (installs node and npm for every user)"

# Succeeds when npm-installable tool $1 (from package $2) is usable by every
# user this install serves, including the node its `#!/usr/bin/env node`
# entry point runs on. Otherwise fails as pipx_tool_usable does.
npm_tool_usable() {
    has "$1" || return 1
    $SYSTEM_INSTALL || return 0
    if ! _shared=$(shared_command_path "$1"); then
        printf 'installed only under %s, so other users cannot run it; run: %s' "$HOME" "$(shared_npm_hint "$2")"
        return 1
    fi
    case "$_shared" in
        "$NPM_SHARED_MODULES/$2"/*)
            if ! dirs_searchable_by_all "$NPM_SHARED_PREFIX/lib" "$NPM_SHARED_MODULES" \
                || ! tree_usable_by_all "$NPM_SHARED_MODULES/$2"; then
                printf '%s is not readable and executable by other users, so they cannot run it; run: %s' "$NPM_SHARED_MODULES/$2" "$(shared_npm_hint "$2")"
                return 1
            fi
            ;;
    esac
    if ! _node=$(shared_command_path node); then
        printf 'needs node, which is not installed outside %s, so other users cannot run it; run: %s' "$HOME" "$SHARED_NODE_HINT"
        return 1
    fi
    if ! tree_usable_by_all "$_node"; then
        printf 'needs node, but %s is not readable and executable by other users, so they cannot run it; run: %s' "$_node" "$SHARED_NODE_HINT"
        return 1
    fi
    return 0
}

# Count of failed checks (invalid config or missing tool).  Any non-zero total
# makes the script exit 1.
ISSUES=0
fail() { ISSUES=$((ISSUES + 1)); }

tick()  { printf "  \033[32m✓\033[0m  %-38s %s\n" "$1" "$2"; }
cross() { printf "  \033[31m✗\033[0m  %-38s %s\n" "$1" "$2"; fail; }
skip()  { printf "  \033[33m–\033[0m  %-38s %s\n" "$1" "$2"; }

# ── Sanity-check the pre-commit config ────────────────────────────────────────
# Every hook in this repo's .pre-commit-config.yaml uses `language: system`
# (calling a binary already on PATH), so there are no managed environments to
# pre-install. We still run `pre-commit validate-config` to surface YAML or
# schema errors here rather than at the next git commit.
if has pre-commit; then
    if pre-commit validate-config "$REPO_DIR/src/.pre-commit-config.yaml"; then
        echo "pre-commit config OK ($(grep -c '^      - id:' "$REPO_DIR/src/.pre-commit-config.yaml") hooks, all language: system)"
    else
        echo "WARN: pre-commit config validation failed — see above" >&2
        fail
    fi
fi

echo ""
if $SYSTEM_INSTALL; then
    echo "System-wide pre-commit hooks (all users)."
else
    echo "Global pre-commit hooks (current user)."
fi
echo "Hooks directory: $HOOKS_DIR"
echo ""
echo "Check status:"
echo "  ✓ active   ✗ tool not installed (skipped)   – conditional on file type"
echo ""

# ── Always-on checks ──────────────────────────────────────────────────────────
echo "Always-on (shell):"
tick  "No merge commits"           ""
tick  "No ignored files tracked"   ""

echo ""
echo "Always-on (pre-commit native hooks):"
tick  "No merge conflict markers"     "check-merge-conflict"
tick  "No case sensitivity conflicts" "check-case-conflict"
tick  "No large files added"          "check-added-large-files"
tick  "End-of-file newline"           "end-of-file-fixer (auto-fix)"
tick  "No trailing whitespace"        "trailing-whitespace (auto-fix)"
tick  "Consistent line endings"       "mixed-line-ending"
tick  "Valid TOML syntax"             "check-toml"
tick  "No private keys"               "detect-private-key"
tick  "Executables have shebangs"     "check-executables-have-shebangs"
tick  "Shebang scripts are +x"        "check-shebang-scripts-are-executable"

if has trufflehog; then
    tick  "Secret scanning (trufflehog)" "$(trufflehog --version 2>/dev/null | head -1)"
else
    cross "Secret scanning (trufflehog)" "not installed — see install instructions below"
fi

# ── Conditional checks ────────────────────────────────────────────────────────
echo ""
echo "Conditional (triggered by file type + tool availability):"

if has dotnet; then
    skip  ".NET build + test (*.cs/csproj/sln)"    "dotnet $(dotnet --version 2>/dev/null)"
else
    cross ".NET build + test (*.cs/csproj/sln)"    "dotnet not installed"
fi

# The local check runs from $HOME so it finds the $HOME tool manifest the
# install-deps scripts write to, whatever directory check-setup is run from.
CSCLEANUP_VERSION=$(cd "$HOME" && dotnet tool list 2>/dev/null | awk 'tolower($3)=="cscleanup"{print $2}')
[ -z "$CSCLEANUP_VERSION" ] && CSCLEANUP_VERSION=$(dotnet tool list --global 2>/dev/null | awk 'tolower($3)=="cscleanup"{print $2}')
if [ -n "$CSCLEANUP_VERSION" ]; then
    skip  "C# format — cscleanup (*.cs)"           "v${CSCLEANUP_VERSION}"
else
    cross "C# format — cscleanup (*.cs)"           "not installed: run from ~ (after 'dotnet new tool-manifest' if ~ has none): dotnet tool install Credfeto.DotNet.Repo.Formatter"
fi

if has npm; then
    skip  "NPM tests (*.ts/tsx/js/jsx)"             "npm $(npm --version 2>/dev/null)"
else
    cross "NPM tests (*.ts/tsx/js/jsx)"             "npm not installed"
fi

if has dotnet; then
    skip  "T-SQL lint — dotnet tsqllint (*.sql)"    "dotnet $(dotnet --version 2>/dev/null)"
else
    cross "T-SQL lint — dotnet tsqllint (*.sql)"    "dotnet not installed"
fi

SQLFLUFF_OK=false
if SQLFLUFF_PROBLEM=$(pipx_tool_usable sqlfluff sqlfluff); then
    SQLFLUFF_OK=true
    skip  "SQL style — sqlfluff (*.sql)"            "$(sqlfluff --version 2>/dev/null)"
else
    cross "SQL style — sqlfluff (*.sql)"            "${SQLFLUFF_PROBLEM:-not installed}"
fi

CFN_LINT_OK=false
if CFN_LINT_PROBLEM=$(pipx_tool_usable cfn-lint cfn-lint); then
    CFN_LINT_OK=true
    skip  "CloudFormation — cfn-lint"               "$(cfn-lint --version 2>/dev/null)"
else
    cross "CloudFormation — cfn-lint"               "${CFN_LINT_PROBLEM:-not installed}"
fi

if has pre-commit; then
    skip  "pre-commit linters"                      "$(pre-commit --version 2>/dev/null)"
else
    cross "pre-commit linters"                      "pre-commit not installed — linting skipped"
fi

# ── Super-linter equivalent via pre-commit ────────────────────────────────────
echo ""
echo "Super-linter equivalent (run by pre-commit, staged files only):"
echo "  – every hook is language: system — tools must be on PATH"
echo ""

# pre-commit-hooks ships ~20 small individual binaries (check-merge-conflict,
# end-of-file-fixer, etc.). Probe a representative one rather than all 13.
PRE_COMMIT_HOOKS_OK=false
if PRE_COMMIT_HOOKS_PROBLEM=$(pipx_tool_usable check-merge-conflict pre-commit-hooks); then
    PRE_COMMIT_HOOKS_OK=true
    skip  "VALIDATE_JSON/XML/YAML/TOML syntax (system)" "pre-commit-hooks (pipx)"
else
    cross "VALIDATE_JSON/XML/YAML/TOML syntax (system)" "pre-commit-hooks ${PRE_COMMIT_HOOKS_PROBLEM:-not installed — run: $(shared_pipx_hint pre-commit-hooks)}"
fi

if has shellcheck; then
    skip  "VALIDATE_BASH — shellcheck       (system)" "$(shellcheck --version 2>/dev/null | grep ^version: || echo present)"
else
    cross "VALIDATE_BASH — shellcheck       (system)" "not installed"
fi

if has yamllint; then
    skip  "VALIDATE_YAML — yamllint         (system)" "$(yamllint --version 2>/dev/null)"
else
    cross "VALIDATE_YAML — yamllint         (system)" "not installed"
fi

if has flake8; then
    skip  "VALIDATE_PYTHON — flake8         (system)" "$(flake8 --version 2>/dev/null | head -1)"
else
    cross "VALIDATE_PYTHON — flake8         (system)" "not installed"
fi

MARKDOWNLINT_OK=false
if MARKDOWNLINT_PROBLEM=$(npm_tool_usable markdownlint markdownlint-cli); then
    MARKDOWNLINT_OK=true
    skip  "VALIDATE_MD — markdownlint       (system)" "$(markdownlint --version 2>/dev/null)"
else
    cross "VALIDATE_MD — markdownlint       (system)" "${MARKDOWNLINT_PROBLEM:-not installed}"
fi

ANSIBLE_LINT_OK=false
if ANSIBLE_LINT_PROBLEM=$(pipx_tool_usable ansible-lint ansible-lint); then
    ANSIBLE_LINT_OK=true
    skip  "VALIDATE_ANSIBLE — ansible-lint  (system)" "$(ansible-lint --version 2>/dev/null | head -1)"
else
    cross "VALIDATE_ANSIBLE — ansible-lint  (system)" "${ANSIBLE_LINT_PROBLEM:-not installed}"
fi

# System hooks (tool must be on PATH)
if has hadolint; then
    skip  "VALIDATE_DOCKERFILE — hadolint   (system)" "$(hadolint --version 2>/dev/null)"
else
    cross "VALIDATE_DOCKERFILE — hadolint   (system)" "not installed"
fi

if has actionlint; then
    skip  "VALIDATE_GITHUB_ACTIONS workflows — actionlint        (system)" "$(actionlint --version 2>/dev/null)"
else
    cross "VALIDATE_GITHUB_ACTIONS workflows — actionlint        (system)" "not installed"
fi

if has composite-action-lint; then
    skip  "VALIDATE_GITHUB_ACTIONS actions  — composite-action-lint (system)" "$(composite-action-lint --version 2>/dev/null || echo present)"
else
    cross "VALIDATE_GITHUB_ACTIONS actions  — composite-action-lint (system)" "not installed"
fi

PYLINT_OK=false
if PYLINT_PROBLEM=$(pipx_tool_usable pylint pylint); then
    PYLINT_OK=true
    skip  "VALIDATE_PYTHON_PYLINT — pylint  (system)" "$(pylint --version 2>/dev/null | head -1)"
else
    cross "VALIDATE_PYTHON_PYLINT — pylint  (system)" "${PYLINT_PROBLEM:-not installed}"
fi

STYLELINT_OK=false
if STYLELINT_PROBLEM=$(npm_tool_usable stylelint stylelint); then
    STYLELINT_OK=true
    skip  "VALIDATE_CSS — stylelint          (system)" "$(stylelint --version 2>/dev/null)"
else
    cross "VALIDATE_CSS — stylelint          (system)" "${STYLELINT_PROBLEM:-not installed}"
fi

if has dotenv-linter; then
    skip  "VALIDATE_ENV — dotenv-linter      (system)" "$(dotenv-linter --version 2>/dev/null)"
else
    cross "VALIDATE_ENV — dotenv-linter      (system)" "not installed"
fi

ESLINT_OK=false
if ESLINT_PROBLEM=$(npm_tool_usable eslint eslint); then
    ESLINT_OK=true
    skip  "VALIDATE_TYPESCRIPT_ES — eslint   (system)" "$(eslint --version 2>/dev/null)"
else
    cross "VALIDATE_TYPESCRIPT_ES — eslint   (system)" "${ESLINT_PROBLEM:-not installed}"
fi

if has xmllint; then
    skip  "VALIDATE_XML — xmllint            (system)" ""
else
    cross "VALIDATE_XML — xmllint            (system)" "not installed"
fi

PWSH_OK=false
if has dotnet && (cd "$HOME" && dotnet pwsh -NoProfile -NonInteractive -Command "Import-Module PSScriptAnalyzer -ErrorAction Stop") > /dev/null 2>&1; then
    PWSH_OK=true
    PWSH_VERSION=$(cd "$HOME" && { dotnet tool list; dotnet tool list -g; } 2>/dev/null | awk 'tolower($3)=="pwsh"{print $2; exit}')
    skip  "VALIDATE_POWERSHELL — PSScriptAnalyzer (system)" "pwsh v${PWSH_VERSION} (dotnet local tool)"
else
    cross "VALIDATE_POWERSHELL — PSScriptAnalyzer (system)" "not installed — run: ./install-deps-arch or ./install-deps-debian"
fi

if has bats; then
    skip  "VALIDATE_BATS: bats tests        (system)" "$(bats --version 2>/dev/null)"
else
    cross "VALIDATE_BATS: bats tests        (system)" "not installed"
fi

if has parallel; then
    skip  "bats --jobs N parallelisation (GNU parallel)" "$(parallel --version 2>/dev/null | head -1)"
else
    cross "bats --jobs N parallelisation (GNU parallel)" "not installed — bats runs serially"
fi

skip  "VALIDATE_SQLFLUFF — sqlfluff (*.sql)"  "handled by dedicated SQL check above"
skip  "VALIDATE_CLOUDFORMATION — cfn-lint"    "handled by dedicated CFN check above"

if has trivy; then
    skip  "Dependency vulnerabilities — trivy (lockfiles)" "$(trivy --version 2>/dev/null | head -1)"
else
    cross "Dependency vulnerabilities — trivy (lockfiles)" "not installed"
fi

# ── Optional tool install hints ───────────────────────────────────────────────
MISSING_SYSTEM=""
$PRE_COMMIT_HOOKS_OK      || MISSING_SYSTEM="$MISSING_SYSTEM pre-commit-hooks"
has shellcheck    || MISSING_SYSTEM="$MISSING_SYSTEM shellcheck"
has yamllint      || MISSING_SYSTEM="$MISSING_SYSTEM yamllint"
has flake8        || MISSING_SYSTEM="$MISSING_SYSTEM flake8"
$MARKDOWNLINT_OK  || MISSING_SYSTEM="$MISSING_SYSTEM markdownlint"
$ANSIBLE_LINT_OK  || MISSING_SYSTEM="$MISSING_SYSTEM ansible-lint"
has trufflehog    || MISSING_SYSTEM="$MISSING_SYSTEM trufflehog"
$SQLFLUFF_OK      || MISSING_SYSTEM="$MISSING_SYSTEM sqlfluff"
$CFN_LINT_OK      || MISSING_SYSTEM="$MISSING_SYSTEM cfn-lint"
has hadolint      || MISSING_SYSTEM="$MISSING_SYSTEM hadolint"
has actionlint             || MISSING_SYSTEM="$MISSING_SYSTEM actionlint"
has composite-action-lint  || MISSING_SYSTEM="$MISSING_SYSTEM composite-action-lint"
$PYLINT_OK        || MISSING_SYSTEM="$MISSING_SYSTEM pylint"
$STYLELINT_OK     || MISSING_SYSTEM="$MISSING_SYSTEM stylelint"
has dotenv-linter || MISSING_SYSTEM="$MISSING_SYSTEM dotenv-linter"
$ESLINT_OK        || MISSING_SYSTEM="$MISSING_SYSTEM eslint"
has xmllint       || MISSING_SYSTEM="$MISSING_SYSTEM xmllint"
$PWSH_OK          || MISSING_SYSTEM="$MISSING_SYSTEM pwsh"
has bats          || MISSING_SYSTEM="$MISSING_SYSTEM bats"
has trivy         || MISSING_SYSTEM="$MISSING_SYSTEM trivy"
has parallel      || MISSING_SYSTEM="$MISSING_SYSTEM parallel"

if [ -n "$MISSING_SYSTEM" ]; then
    echo ""
    echo "To install missing system tools:"
    $PRE_COMMIT_HOOKS_OK || echo "  pre-commit-hooks: $(shared_pipx_hint pre-commit-hooks)  # provides ~20 individual check-* / end-of-file-fixer / etc. bins"
    has shellcheck    || echo "  shellcheck:     apt install shellcheck  # or brew install shellcheck"
    has yamllint      || echo "  yamllint:       pip install yamllint  # or apt install yamllint"
    has flake8        || echo "  flake8:         pip install flake8    # or apt install flake8"
    $MARKDOWNLINT_OK  || echo "  markdownlint:   $(shared_npm_hint markdownlint-cli)"
    $ANSIBLE_LINT_OK  || echo "  ansible-lint:   $(shared_pipx_hint ansible-lint)  # or apt install ansible-lint"
    has trufflehog    || echo "  trufflehog:     curl -sSfL https://raw.githubusercontent.com/trufflesecurity/trufflehog/main/scripts/install.sh | sh -s -- -b /usr/local/bin"
    has hadolint      || echo "  hadolint:       brew install hadolint  # or https://github.com/hadolint/hadolint/releases"
    has actionlint             || echo "  actionlint:             brew install actionlint  # or https://github.com/rhysd/actionlint/releases"
    has composite-action-lint  || echo "  composite-action-lint:  go install github.com/bettermarks/composite-action-lint/cmd/composite-action-lint@latest"
    $PYLINT_OK        || echo "  pylint:         $(shared_pipx_hint pylint)"
    $STYLELINT_OK     || echo "  stylelint:      $(shared_npm_hint "stylelint stylelint-config-standard")"
    has dotenv-linter || echo "  dotenv-linter:  https://github.com/dotenv-linter/dotenv-linter/releases"
    $ESLINT_OK        || echo "  eslint:         $(shared_npm_hint eslint)"
    $SQLFLUFF_OK      || echo "  sqlfluff:       $(shared_pipx_hint sqlfluff)"
    $CFN_LINT_OK      || echo "  cfn-lint:       $(shared_pipx_hint cfn-lint)"
    has xmllint       || echo "  xmllint:        apt install libxml2-utils  # or brew install libxml2"
    $PWSH_OK          || echo "  pwsh:           run ./install-deps-arch or ./install-deps-debian (installs as a local dotnet tool + PSScriptAnalyzer module)"
    has bats          || echo "  bats:           apt install bats  # or pacman -S bash-bats"
    has trivy         || echo "  trivy:          pacman -S trivy  # or https://github.com/aquasecurity/trivy/releases"
    has parallel      || echo "  parallel:       apt install parallel  # or pacman -S parallel"
fi

echo ""
if [ "$ISSUES" -ne 0 ]; then
    die "setup incomplete — ${ISSUES} check(s) failed; resolve the items marked ✗ above"
fi

if [ -t 1 ]; then
    printf '\033[32m✓\033[0m %s\n' "setup complete — all checks configured."
else
    printf '✓ %s\n' "setup complete — all checks configured."
fi
exit 0
