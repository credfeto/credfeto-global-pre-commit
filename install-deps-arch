#!/bin/bash
# Install dependencies for credfeto-global-pre-commit on Arch Linux.
# Safe to run multiple times: pacman --needed skips already-installed packages,
# the release and go installs skip tools already present, and pipx upgrades
# packages already installed.
#
# Expects Chaotic-AUR to be configured as a pacman repo, because some of the
# pacman packages below are only available from it.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib/common.sh
. "$SCRIPT_DIR/lib/common.sh"

detect_arch

# ── Locale ────────────────────────────────────────────────────────────────────
LOCALES_MISSING=0
for loc in en_GB.UTF-8 en_US.UTF-8; do
    locale -a 2>/dev/null | grep -qi "${loc//UTF-8/utf8}" || {
        sudo sed -i "s/^#\($loc\)/\1/" /etc/locale.gen
        LOCALES_MISSING=1
    }
done
if [ "$LOCALES_MISSING" -eq 1 ]; then
    sudo locale-gen || die "locale-gen failed"
fi

# ── Repository packages ───────────────────────────────────────────────────────
info "pacman packages"
sudo pacman -S --needed --noconfirm \
    git \
    bats \
    go \
    pre-commit \
    shellcheck \
    yamllint \
    python-flake8 \
    python-pylint \
    ansible-lint \
    libxml2 \
    python-pipx \
    trivy \
    parallel \
    curl \
    nvm \
    sqlfluff \
    python-cfn-lint \
    || die "pacman install failed"

# ── Binary tools from GitHub releases ────────────────────────────────────────
# install_release_linters installs hadolint, dotenv-linter and trufflehog.
# hadolint and dotenv-linter are in neither the official repos nor Chaotic-AUR,
# and trufflehog is not in the official repos.
info "Binary tools from GitHub releases"
install_github_release actionlint rhysd/actionlint "actionlint_VERSION_linux_ARCH.tar.gz"
install_release_linters

# ── Go tools ──────────────────────────────────────────────────────────────────
info "Go tools"
has go || die "go not found, but pacman should have installed it"
install_composite_action_lint

# ── pipx packages ─────────────────────────────────────────────────────────────
# python-pre-commit-hooks does not exist in AUR; pipx is the only option.
# Provides check-merge-conflict, end-of-file-fixer, check-json, etc.
info "pipx packages"
pipx_ensure pre-commit-hooks

# ── npm global packages ───────────────────────────────────────────────────────
# The pacman nvm package does not load nvm into the shell, so node stays off
# PATH until the user sources its init script.
install_npm_globals "add this to your shell rc (e.g. ~/.bashrc), open a new shell,
  install a Node.js version with nvm, then re-run this script:
  source /usr/share/nvm/init-nvm.sh"

# ── PowerShell ────────────────────────────────────────────────────────────────
install_pwsh

# ── cscleanup (C# formatter dotnet tool) ──────────────────────────────────────
install_cscleanup

success "All dependencies installed."
info "Run ./install to register the global git hooks."
