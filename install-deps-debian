#!/bin/bash
# Install dependencies for credfeto-global-pre-commit on Debian / Ubuntu.
# Safe to run multiple times: apt is idempotent, binary installs are skipped
# if the tool is already present, and pipx upgrades already-installed packages.
#
# Tested on Ubuntu 22.04 LTS and Debian 12 (Bookworm).

set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib/common.sh
. "$SCRIPT_DIR/lib/common.sh"

detect_arch

# ── Locale ────────────────────────────────────────────────────────────────────
info "locale"
for loc in en_GB.UTF-8 en_US.UTF-8; do
    locale -a 2>/dev/null | grep -qi "${loc//UTF-8/utf8}" \
        || sudo locale-gen "$loc" || die "locale-gen $loc failed"
done

# ── System packages ───────────────────────────────────────────────────────────
info "apt packages"
sudo apt-get update -qq || die "apt-get update failed"
sudo apt-get install -y \
    git \
    bats \
    pre-commit \
    shellcheck \
    yamllint \
    python3-flake8 \
    python3-venv \
    libxml2-utils \
    curl \
    gpg \
    pipx \
    parallel \
    || die "apt-get install failed"

# Ensure pipx is available even on older systems that lack the apt package.
if ! has pipx; then
    sudo apt-get install -y python3-pip || die "failed to install python3-pip"
    python3 -m pip install --user pipx || die "failed to install pipx via pip"
    python3 -m pipx ensurepath || die "pipx ensurepath failed"
fi

# ansible-lint is in Ubuntu 22.04+ repos; fall back to pipx on older releases.
info "ansible-lint"
if ! sudo apt-get install -y ansible-lint 2>/dev/null; then
    info "ansible-lint not in apt, installing via pipx"
    pipx_ensure ansible-lint
fi

# pylint: apt package removed in Ubuntu 24.04+; fall back to pipx.
info "pylint"
if ! sudo apt-get install -y python3-pylint 2>/dev/null; then
    info "python3-pylint not in apt, installing pylint via pipx"
    pipx_ensure pylint
fi

# ── PowerShell ────────────────────────────────────────────────────────────────
install_pwsh

# ── cscleanup (C# formatter dotnet tool) ──────────────────────────────────────
install_cscleanup

# ── pipx packages ─────────────────────────────────────────────────────────────
# pre-commit-hooks provides the individual check-* / end-of-file-fixer / etc.
# binaries used by the language: system hooks in .pre-commit-config.yaml.
info "pipx packages"
for pkg in pre-commit-hooks sqlfluff cfn-lint; do
    pipx_ensure "$pkg"
done

# Ensure ~/.local/bin is on PATH for this session (pipx installs land there).
export PATH="$HOME/.local/bin:$PATH"

# ── nvm ───────────────────────────────────────────────────────────────────────
# nvm is not in apt; use the official install script.
info "nvm"
if [ ! -s "$HOME/.nvm/nvm.sh" ]; then
    curl -sSfo- https://raw.githubusercontent.com/nvm-sh/nvm/HEAD/install.sh | bash \
        || die "nvm install failed"
else
    info "nvm already installed, skipping"
fi

# ── npm global packages ───────────────────────────────────────────────────────
install_npm_globals

# ── Binary releases from GitHub ───────────────────────────────────────────────
# These tools have no Debian package; binaries are downloaded from GitHub
# releases and installed to /usr/local/bin.
info "Binary tools from GitHub releases"

install_release_linters

# actionlint: prefer go install, fall back to binary download
if has go; then
    if ! has actionlint; then
        go install github.com/rhysd/actionlint/cmd/actionlint@latest || die "failed to install actionlint"
    else
        info "actionlint already installed, skipping"
    fi
    install_composite_action_lint
else
    install_github_release actionlint rhysd/actionlint "actionlint_VERSION_linux_ARCH.tar.gz"
    warn "go not found, skipping composite-action-lint (install go and rerun)"
fi

# trivy's release assets use "64bit"/"ARM64" naming, incompatible with the
# UARCH/ARCH placeholders (uname -m / go arch) install_github_release fills in,
# so the asset template is picked per-arch here, as install_release_linters
# does for hadolint.
case "$ARCH_UNAME" in
    x86_64)  install_github_release trivy aquasecurity/trivy "trivy_VERSION_Linux-64bit.tar.gz" ;;
    aarch64) install_github_release trivy aquasecurity/trivy "trivy_VERSION_Linux-ARM64.tar.gz" ;;
esac

success "All dependencies installed."
info "You may need to start a new shell for PATH changes (pipx) to take effect."
info "Run ./install to register the global git hooks."
